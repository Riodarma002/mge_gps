# Environment Variables — salin file ini ke .env dan isi nilainya
# Jangan commit .env ke GitHub!

# Wialon API
VITE_WIALON_TOKEN=your_wialon_token_here
VITE_WIALON_API_URL=https://hst-api.wialon.eu

# Default map center (koordinat proyek)
VITE_DEFAULT_LAT=-6.178
VITE_DEFAULT_LNG=106.630
VITE_DEFAULT_ZOOM=9

# Tile server (opsional — kosongkan jika pakai OSM default)
VITE_TILE_URL=
VITE_TILE_LABEL=Custom Map

# Mapbox token (opsional — untuk layer Mapbox Streets & Drone)
VITE_MAPBOX_TOKEN=your_mapbox_token_here
